# Example environment variables for local development
# Copy this file to .dev.vars (gitignored) for local Wrangler dev

# Cloudflare API credentials (only needed for CI/CD)
# CLOUDFLARE_API_TOKEN=your-api-token-here
# CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Lab zone configuration
LAB_ZONE_ID=replace-with-dtg-lab-net-zone-id
LAB_ACCOUNT_ID=replace-with-your-account-id

# Simulation zone (often same as LAB_ZONE_ID for the dtg-lab.net zone)
SIM_ZONE_ID=replace-with-dtg-lab-net-zone-id

# Production zone (customer Enterprise zone)
PROD_ZONE_ID=replace-with-customer-zone-id
PROD_ACCOUNT_ID=replace-with-customer-account-id
