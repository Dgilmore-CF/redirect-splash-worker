{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redirect-splash-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // DTG Lab account (not the FEDRAMP one). Override with CLOUDFLARE_ACCOUNT_ID env var if needed.
  "account_id": "430470778f0d9dbd89d3d69637b2ae9d",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // ============================================================
  // Default environment: Lab (DTG Lab)
  // ============================================================
  // To deploy to lab: `wrangler deploy`
  // ============================================================
  "routes": [
    {
      "pattern": "hr.dtg-lab.net",
      "custom_domain": true
    },
    {
      "pattern": "fs.gmis.dtg-lab.net",
      "custom_domain": true
    }
  ],

  "vars": {
    "COUNTDOWN_SECONDS": "8",
    "ENABLE_AB_TESTING": "true",
    "DEFAULT_LANGUAGE": "en",
    "ORG_NAME": "DTG Lab",
    "SUPPORT_EMAIL": "support@dtg-lab.net",
    "ENVIRONMENT": "lab",
    // Optional branding. Leave empty to disable.
    // Must be an https:// URL or a data:image/...;base64,... URI.
    "BACKGROUND_IMAGE_URL": "",
    "LOGO_URL": ""
  },

  // Analytics Engine binding for tracking redirect events
  // Create dataset in dashboard: Workers & Pages > Analytics Engine
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "redirect_splash_events"
    }
  ],

  // ============================================================
  // Production environment (customer Enterprise zone)
  // ============================================================
  // To deploy: `wrangler deploy --env production`
  // ============================================================
  "env": {
    "production": {
      "name": "redirect-splash-worker-prod",
      "routes": [
        {
          "pattern": "hr.example.com",
          "custom_domain": true
        },
        {
          "pattern": "fs.example.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "COUNTDOWN_SECONDS": "10",
        "ENABLE_AB_TESTING": "false",
        "DEFAULT_LANGUAGE": "en",
        "ORG_NAME": "Your Organization",
        "SUPPORT_EMAIL": "helpdesk@example.com",
        "ENVIRONMENT": "production",
        "BACKGROUND_IMAGE_URL": "",
        "LOGO_URL": ""
      },
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "redirect_splash_events_prod"
        }
      ]
    },
    // ============================================================
    // Simulation environment - mimics legacy + new portals
    // ============================================================
    // This deploys the simulation pages so you can test the full
    // user journey. Deploy with: `wrangler deploy --env simulation`
    //
    // Note: this uses a different `main` entry point (simulation.ts)
    // so it does not need the splash worker's vars (countdown, etc.)
    // or the analytics binding.
    // ============================================================
    "simulation": {
      "name": "redirect-splash-simulation",
      "main": "src/simulation.ts",
      "routes": [
        {
          "pattern": "hcmx.gmis.dtg-lab.net/*",
          "zone_id": "6f981de3d6d010bcfc80b0f3ccad7e29"
        },
        {
          "pattern": "fscmx.gmis.dtg-lab.net/*",
          "zone_id": "6f981de3d6d010bcfc80b0f3ccad7e29"
        }
      ],
      "vars": {
        "ENVIRONMENT": "simulation",
        // The next vars are not used by simulation.ts but must
        // be declared so wrangler doesn't warn about inheritance.
        "COUNTDOWN_SECONDS": "0",
        "ENABLE_AB_TESTING": "false",
        "DEFAULT_LANGUAGE": "en",
        "ORG_NAME": "DTG Lab Simulation",
        "SUPPORT_EMAIL": "support@dtg-lab.net",
        "BACKGROUND_IMAGE_URL": "",
        "LOGO_URL": ""
      },
      // No analytics for simulation portals
      "analytics_engine_datasets": []
    }
  }
}
